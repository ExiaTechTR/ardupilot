# hw definition file for processing by chibios_hwdef.py
# for Exia EX-1013 R1 (falcon) flight controller (STM32F405RGT6)
# pin mapping taken from EX-1013_R1/Schematics/mcu.SchDoc

# MCU class and specific type
MCU STM32F4xx STM32F405xx

# board ID. Not allocated upstream; see Tools/AP_Bootloader/board_types.txt
APJ_BOARD_ID 61013

# crystal frequency, setup to use external oscillator
OSCILLATOR_HZ 8000000

FLASH_SIZE_KB 1024

# bootloader takes first sector
FLASH_RESERVE_START_KB 48

# the bootloader built from hwdef-bl.dat hung at boot on EX-1013 R1 (no USB,
# LEDs dark), so don't embed it or allow flashing it from the firmware
define AP_BOOTLOADER_FLASHING_ENABLED 0

define HAL_STORAGE_SIZE 16384
define STORAGE_FLASH_PAGE 1

STM32_ST_USE_TIMER 5

# SPI1 - IMU
PA5 SPI1_SCK SPI1
PA6 SPI1_MISO SPI1
PA7 SPI1_MOSI SPI1

# SPI2 - OSD
PB13 SPI2_SCK SPI2
PB14 SPI2_MISO SPI2
PB15 SPI2_MOSI SPI2

# SPI3 - dataflash
PB3 SPI3_SCK SPI3
PB4 SPI3_MISO SPI3
PB5 SPI3_MOSI SPI3

# Chip select pins
PA4 GYRO1_CS CS
PB12 OSD1_CS CS
PB1 FLASH1_CS CS

# IMU data ready
PC4 GYRO_INT INPUT

# Beeper (PC5 has no timer, so GPIO buzzer via T2)
PC5 BUZZER OUTPUT GPIO(80) LOW
define HAL_BUZZER_PIN 80

# SERIAL ports
SERIAL_ORDER OTG1 USART1 USART2 USART3 UART4 UART5 USART6
PA11 OTG_FS_DM OTG1
PA12 OTG_FS_DP OTG1

# USART1 - VTX (J23) / DJI (J25)
PA9 USART1_TX USART1
PA10 USART1_RX USART1

# USART2 - RC input (J4, SBUS on J5 through T1 inverter)
PA2 USART2_TX USART2
PA3 USART2_RX USART2
define DEFAULT_SERIAL2_PROTOCOL SerialProtocol_RCIN

# USART3 - GPS (J18)
PC10 USART3_TX USART3
PC11 USART3_RX USART3
define DEFAULT_SERIAL3_PROTOCOL SerialProtocol_GPS

# UART4 - spare (J3)
PA0 UART4_TX UART4
PA1 UART4_RX UART4

# UART5 - ESC telemetry on RX (J1/J7), J17
PC12 UART5_TX UART5
PD2 UART5_RX UART5
define DEFAULT_SERIAL5_PROTOCOL SerialProtocol_ESCTelemetry

# USART6 - spare (J16)
PC6 USART6_TX USART6
PC7 USART6_RX USART6

# I2C2 - BMP280 (0x76) and external J10
PB10 I2C2_SCL I2C2
PB11 I2C2_SDA I2C2
I2C_ORDER I2C2

# ADC
PC0 BATT_VOLTAGE_SENS ADC1 SCALE(1)
define HAL_BATT_VOLT_PIN 10
# 18k / 2k divider
define HAL_BATT_VOLT_SCALE 10.0
PC1 BATT_CURRENT_SENS ADC1 SCALE(1)
define HAL_BATT_CURR_PIN 11
# current sensor is on the ESC; scale must match it
define HAL_BATT_CURR_SCALE 40.0
define HAL_BATT_MONITOR_DEFAULT 4
PC2 RSSI_ADC ADC1
define BOARD_RSSI_ANA_PIN 12

# MOTORS (J1/J7)
PB6 TIM4_CH1 TIM4 PWM(1) GPIO(50) # M1
PB7 TIM4_CH2 TIM4 PWM(2) GPIO(51) # M2
PB8 TIM4_CH3 TIM4 PWM(3) GPIO(52) # M3
PB9 TIM4_CH4 TIM4 PWM(4) GPIO(53) # M4

# Servos (J14, J15) and camera control
PC8 TIM8_CH3 TIM8 PWM(5) GPIO(54) # SERVO_1
PB0 TIM3_CH3 TIM3 PWM(6) GPIO(55) # SERVO_2
PC9 TIM8_CH4 TIM8 PWM(7) GPIO(56) # CAM_CC

# 9V VTX/camera regulator enable (pulled up by R29) and camera mux select
PC14 PINIO1 OUTPUT GPIO(81) HIGH
define RELAY1_PIN_DEFAULT 81
PC15 PINIO2 OUTPUT GPIO(82) LOW
define RELAY2_PIN_DEFAULT 82

# LEDs (active high)
define AP_NOTIFY_GPIO_LED_2_ENABLED 1
PC13 LED_GREEN OUTPUT LOW GPIO(90)
PA8 LED_RED OUTPUT LOW GPIO(91)
define HAL_GPIO_A_LED_PIN 90
define HAL_GPIO_B_LED_PIN 91
define HAL_GPIO_LED_ON 1

# Dataflash setup
SPIDEV dataflash SPI3 DEVID1 FLASH1_CS MODE3 104*MHZ 104*MHZ
define HAL_LOGGING_DATAFLASH_ENABLED 1

# OSD setup (AT7456E, MAX7456 compatible)
SPIDEV osd SPI2 DEVID1 OSD1_CS MODE0 10*MHZ 10*MHZ
define OSD_ENABLED 1
define HAL_OSD_TYPE_DEFAULT 1
ROMFS_WILDCARD libraries/AP_OSD/fonts/font*.bin

# BARO setup: Goertek SPA06-003 (SPL06 family, BMP280 footprint, SDO low)
BARO SPL06 I2C:0:0x76
BARO SPL06 I2C:0:0x77
define AP_BARO_BACKEND_DEFAULT_ENABLED 0
define AP_BARO_SPL06_ENABLED 1

# IMU setup: QST QMI8658A fitted on the ICM-42688-P footprint (U4)
# U4 is on the bottom layer at 180 deg. The QMI8658A axes sit 180 deg in
# yaw from the ICM-42688-P on the same footprint; rotation verified by tilt
# test (nose up, right side down, level)
SPIDEV imu1 SPI1 DEVID1 GYRO1_CS MODE3 1*MHZ 8*MHZ
IMU QMI8658 SPI:imu1 ROTATION_YAW_270
# TEMP bring-up: report WHOAMI on probe failure and missed samples
define HAL_QMI8658_DEBUG 1
DMA_NOSHARE SPI1*
DMA_PRIORITY TIM4* SPI1*

# no built-in compass, but probe the i2c bus for all possible
# external compass types
define AP_COMPASS_PROBING_ENABLED 1
define HAL_I2C_INTERNAL_MASK 0
define HAL_COMPASS_AUTO_ROT_DEFAULT 2
# Motor order implies Betaflight/X for standard ESCs
define HAL_FRAME_TYPE_DEFAULT 12
define HAL_INS_TEMPERATURE_CAL_ENABLE 1

include ../include/minimize_fpv_osd.inc
